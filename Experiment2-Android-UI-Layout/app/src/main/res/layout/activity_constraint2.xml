<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trip_gray">

    <!-- ========== 顶部标签栏 ========== -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/trip_tab_height"
        android:background="@color/trip_tab_bar"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/space_station_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_tab_stations"
                android:textColor="@color/trip_tab_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/rocket_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_tab_flights"
                android:textColor="@color/trip_tab_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/rover_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_tab_rovers"
                android:textColor="@color/trip_tab_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== DCA ↔ MARS 区块 ========== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/routeBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tabBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- DCA 方块 -->
        <TextView
            android:id="@+id/tvDca"
            android:layout_width="120dp"
            android:layout_height="90dp"
            android:background="@color/trip_green"
            android:gravity="center"
            android:text="@string/trip_dca"
            android:textColor="@color/trip_white"
            android:textSize="@dimen/trip_text_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- MARS 方块，紧挨 DCA -->
        <TextView
            android:id="@+id/tvMars"
            android:layout_width="120dp"
            android:layout_height="90dp"
            android:layout_marginStart="20dp"
            android:background="@color/trip_green"
            android:gravity="center"
            android:text="@string/trip_mars"
            android:textColor="@color/trip_white"
            android:textSize="@dimen/trip_text_size"
            app:layout_constraintTop_toTopOf="@id/tvDca"
            app:layout_constraintBottom_toBottomOf="@id/tvDca"
            app:layout_constraintStart_toEndOf="@id/tvDca" />

        <!-- 双箭头，叠在两个方块中间，图层在上 -->
        <ImageView
            android:id="@+id/ivDoubleArrow"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:src="@drawable/double_arrows"
            app:layout_constraintTop_toTopOf="@id/tvDca"
            app:layout_constraintBottom_toBottomOf="@id/tvDca"
            app:layout_constraintStart_toStartOf="@id/tvDca"
            app:layout_constraintEnd_toEndOf="@id/tvMars" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========== One Way 条 ========== -->
    <LinearLayout
        android:id="@+id/oneWayBlock"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/trip_bar_height"
        android:layout_marginStart="@dimen/trip_padding"
        android:layout_marginTop="24dp"
        android:background="@color/trip_orange"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/trip_padding"
        app:layout_constraintTop_toBottomOf="@id/routeBlock"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trip_one_way"
            android:textColor="@color/trip_white"
            android:textSize="@dimen/trip_text_size" />

        <Switch
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:checked="true" />
    </LinearLayout>

    <!-- ========== 1 Traveller 条 ========== -->
    <TextView
        android:id="@+id/tvTraveller"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/trip_bar_height"
        android:layout_marginStart="@dimen/trip_padding"
        android:layout_marginTop="8dp"
        android:background="@color/trip_orange"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/trip_padding"
        android:text="@string/trip_traveller"
        android:textColor="@color/trip_white"
        android:textSize="@dimen/trip_text_size"
        app:layout_constraintTop_toBottomOf="@id/oneWayBlock"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ========== 中间星系图 + 左边小图 ========== -->
    <LinearLayout
        android:id="@+id/planetBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/tvTraveller"
        app:layout_constraintBottom_toTopOf="@id/btnDepart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/rocket_icon" />

        <ImageView
            android:id="@+id/ivPlanet"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/galaxy" />
    </LinearLayout>

    <!-- ========== 底部 DEPART 按钮 ========== -->
    <Button
        android:id="@+id/btnDepart"
        android:layout_width="0dp"
        android:layout_height="@dimen/trip_depart_height"
        android:backgroundTint="@color/trip_green"
        android:text="@string/trip_depart"
        android:textColor="@color/trip_white"
        android:textSize="@dimen/trip_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>