            android:layout_height="match_parent"
            android:layout_margin="@dimen/grid_margin"
            android:layout_weight="3"
            android:background="@drawable/grid_cell_bg"
            android:gravity="center"
            android:text="@string/cell_one_one"
            android:textColor="@color/white"
            android:textSize="@dimen/grid_text_size" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/grid_margin"
            android:layout_weight="2"
            android:background="@drawable/grid_cell_bg"
            android:gravity="center"
            android:text="@string/cell_one_two"
            android:textColor="@color/white"
            android:textSize="@dimen/grid_text_size" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/grid_margin"
            android:layout_weight="1"
            android:background="@drawable/grid_cell_bg"
            android:gravity="center"
            android:text="@string/cell_one_three"
