<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 菜单项名称，左对齐 -->
    <style name="MenuItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">#CCCCCC</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 快捷键，右对齐 -->
    <style name="MenuShortcut">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">#CCCCCC</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">right</item>
    </style>

    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/calc_button_height</item>
        <item name="android:layout_margin">@dimen/calc_margin</item>
        <item name="android:backgroundTint">@color/calc_button_bg</item>
        <item name="android:textColor">@color/calc_display_text</item>
        <item name="android:textSize">@dimen/calc_text_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>